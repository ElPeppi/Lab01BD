# Copia este archivo como backend/.env y completa los valores (el .env nunca se sube al repo)
DB_NAME=biblioteca
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
# true: conexión cifrada con el certificado de AWS RDS (certs/global-bundle.pem).
# false: para un MySQL local (localhost) sin ese certificado.
DB_SSL=true
# Clave larga y aleatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
